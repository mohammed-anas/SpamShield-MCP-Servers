<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.javahub</groupId>
    <artifactId>spam-shield-mcp-servers</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spam Shield MCP Servers</name>
    <description>Reactive Spring MCP servers for Spam Shield. Each server is its own process and container and queries an external Postgres database.</description>

    <modules>
        <module>spam-shield-common</module>
        <module>call-records-mcp-server</module>
        <module>call-records-rest-server</module>
<!--        <module>url-reputation-mcp</module>-->
<!--        <module>sender-reputation-mcp</module>-->
<!--        <module>policy-decision-mcp</module>-->
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
